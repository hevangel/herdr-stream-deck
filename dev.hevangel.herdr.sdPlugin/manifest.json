{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "dev.hevangel.herdr",
    "Version": "1.0.0.0",
    "Author": "hevangel",
    "Description": "Control herdr - your herd of AI coding agents - from Stream Deck keys: fleet status, prompts, keystrokes and spawning agents, locally, over SSH, or in Docker.",
    "UUID": "dev.hevangel.herdr",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "CodePath": "bin/plugin.js",
    "Nodejs": {
        "Version": "20",
        "Debug": "enabled"
    },
    "Icon": "plugin-icon",
    "Category": "dev.hevangel.herdr",
    "CategoryIcon": "imgs/plugin/category",
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        },
        {
            "Platform": "mac",
            "MinimumVersion": "13"
        }
    ],
    "Actions": [
        {
            "Name": "Fleet Status",
            "UUID": "dev.hevangel.herdr.fleet-status",
            "Icon": "imgs/actions/fleet/icon",
            "Tooltip": "Live agent state counts for one herdr target. Press to refresh.",
            "PropertyInspectorPath": "ui/fleet.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/fleet/key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "Agent Command",
            "UUID": "dev.hevangel.herdr.agent-command",
            "Icon": "imgs/actions/agent/icon",
            "Tooltip": "Send a prompt or keystrokes to one agent. Long-press sends an interrupt.",
            "PropertyInspectorPath": "ui/agent.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/agent/key",
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "Name": "Agent Focus",
            "UUID": "dev.hevangel.herdr.agent-focus",
            "Icon": "imgs/actions/focus/icon",
            "Tooltip": "One agent per key: shows its kind icon and live state; press to focus the herdr tab hosting it.",
            "PropertyInspectorPath": "ui/focus.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/focus/key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "Spawn Agent",
            "UUID": "dev.hevangel.herdr.spawn-agent",
            "Icon": "imgs/actions/spawn/icon",
            "Tooltip": "Split a pane and start a coding agent (claude, codex, ...) in it.",
            "PropertyInspectorPath": "ui/spawn.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/spawn/key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "Deck Slot",
            "UUID": "dev.hevangel.herdr.deck-slot",
            "Icon": "imgs/actions/deck/slot-icon",
            "Tooltip": "Dynamic top-row slot (0-9): displays Agents, Machines, Windows, or Tabs based on the active mode.",
            "PropertyInspectorPath": "ui/deck-slot.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/deck/slot-key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "List Agents",
            "UUID": "dev.hevangel.herdr.mode-agents",
            "Icon": "imgs/actions/deck/mode-icon",
            "Tooltip": "Switch top-row Deck Slots to list live agents (default view).",
            "PropertyInspectorPath": "ui/deck-mode.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/deck/mode-key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "List Machines",
            "UUID": "dev.hevangel.herdr.mode-machines",
            "Icon": "imgs/actions/deck/mode-icon",
            "Tooltip": "Switch top-row Deck Slots to list machines; press a machine to open its Windows view.",
            "PropertyInspectorPath": "ui/deck-mode.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/deck/mode-key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "List Windows",
            "UUID": "dev.hevangel.herdr.mode-windows",
            "Icon": "imgs/actions/deck/mode-icon",
            "Tooltip": "Switch top-row Deck Slots to list windows (workspaces) of the active machine.",
            "PropertyInspectorPath": "ui/deck-mode.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/deck/mode-key",
                    "TitleAlignment": "middle"
                }
            ]
        },
        {
            "Name": "List Tabs",
            "UUID": "dev.hevangel.herdr.mode-tabs",
            "Icon": "imgs/actions/deck/mode-icon",
            "Tooltip": "Switch top-row Deck Slots to list tabs of the focused window.",
            "PropertyInspectorPath": "ui/deck-mode.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/deck/mode-key",
                    "TitleAlignment": "middle"
                }
            ]
        }
    ]
}
